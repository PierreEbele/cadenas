{
  "name": "cadenas",
  "version": "1.4.1",
  "description": "Encrypt a file with a password, simply: in the browser (nothing leaves your device) or on the command line. age-compatible.",
  "keywords": [
    "encryption",
    "file-encryption",
    "encrypt",
    "decrypt",
    "password",
    "passphrase",
    "age",
    "age-encryption",
    "argon2",
    "argon2id",
    "xchacha20-poly1305",
    "privacy",
    "offline",
    "pwa",
    "cli",
    "chiffrement"
  ],
  "homepage": "https://pierreebele.github.io/cadenas/",
  "bugs": {
    "url": "https://github.com/PierreEbele/cadenas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PierreEbele/cadenas.git"
  },
  "license": "MIT",
  "author": "Pierre Ebele",
  "type": "module",
  "bin": {
    "cadenas": "bin/cadenas.js"
  },
  "exports": "./src/core.js",
  "files": [
    "bin/",
    "src/",
    "docs/FORMAT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:exe": "node scripts/build-sea.js",
    "preview": "vite preview",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"bin/**\" --test-coverage-exclude=\"src/wordlists/**\" --test-coverage-lines=80",
    "lint": "eslint .",
    "release:tag": "node scripts/tag-release.js",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "age-encryption": "^0.3.1",
    "client-zip": "^2.5.1",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "postject": "^1.0.0-alpha.6",
    "vite": "^8.3.1"
  }
}
