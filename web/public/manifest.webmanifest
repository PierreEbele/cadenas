{
  "name": "cadenas",
  "short_name": "cadenas",
  "description": "Chiffrez un fichier avec un mot de passe, directement dans votre navigateur. Fonctionne hors ligne.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f5f2",
  "theme_color": "#116a55",
  "categories": ["security", "utilities", "productivity"],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/octet-stream": [".cadenas", ".age"] }
    }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
